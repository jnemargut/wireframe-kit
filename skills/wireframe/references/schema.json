{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wireframe Kit file",
  "type": "object",
  "required": [
    "title",
    "screens"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "device": {
      "oneOf": [
        {
          "enum": [
            "phone",
            "phone-small",
            "phone-large",
            "tablet",
            "tablet-landscape",
            "laptop",
            "desktop",
            "watch"
          ]
        },
        {
          "type": "object",
          "required": [
            "w",
            "h"
          ],
          "properties": {
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            }
          }
        }
      ]
    },
    "start": {
      "type": "string"
    },
    "shared": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/node"
      }
    },
    "screens": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/screen"
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "dx": {
              "type": "number"
            },
            "dy": {
              "type": "number"
            },
            "scale": {
              "type": "number"
            },
            "hidden": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "definitions": {
    "screen": {
      "type": "object",
      "required": [
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "dir": {
          "enum": [
            "down",
            "right"
          ]
        },
        "gap": {
          "type": "number"
        },
        "pad": {
          "type": "number"
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "scroll": {
          "type": "boolean"
        },
        "statusbar": {
          "type": "boolean"
        },
        "device": {
          "oneOf": [
            {
              "enum": [
                "phone",
                "phone-small",
                "phone-large",
                "tablet",
                "tablet-landscape",
                "laptop",
                "desktop",
                "watch"
              ]
            },
            {
              "type": "object",
              "required": [
                "w",
                "h"
              ],
              "properties": {
                "w": {
                  "type": "number"
                },
                "h": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "note": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        "chrome": {
          "enum": [
            "phone",
            "tablet",
            "watch",
            "laptop",
            "desktop",
            "plain",
            "none"
          ]
        },
        "versionOf": {
          "type": "string",
          "description": "This screen is another device's version of that screen."
        },
        "shapes": {
          "type": "array",
          "description": "Designer drawings (editor-owned).",
          "items": {
            "type": "object",
            "required": [
              "type",
              "points"
            ],
            "properties": {
              "type": {
                "enum": [
                  "rect",
                  "ellipse",
                  "line",
                  "arrow",
                  "path",
                  "text"
                ]
              },
              "points": {
                "type": "array"
              },
              "text": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "fill": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            }
          }
        },
        "markup": {
          "type": "array",
          "description": "Play-mode sharpie marks (editor-owned).",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "type"
          ]
        },
        {
          "required": [
            "use"
          ]
        }
      ],
      "additionalProperties": false,
      "properties": {
        "children": {
          "description": "What's inside, in order.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        "gap": {
          "description": "Space between children (px).",
          "type": "number",
          "minimum": 0
        },
        "pad": {
          "description": "Space inside the edges (px).",
          "type": "number",
          "minimum": 0
        },
        "align": {
          "description": "Cross-axis alignment of children that don't fill.",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "justify": {
          "description": "Main-axis distribution of leftover space.",
          "enum": [
            "start",
            "center",
            "end",
            "between"
          ]
        },
        "dir": {
          "description": "Stack direction.",
          "enum": [
            "down",
            "right"
          ]
        },
        "wrap": {
          "description": "Wrap onto more lines when it runs out of room.",
          "type": "boolean"
        },
        "flat": {
          "description": "No border, just a soft fill.",
          "type": "boolean"
        },
        "title": {
          "description": "The section heading.",
          "type": [
            "string",
            "number"
          ]
        },
        "action": {
          "description": "Small link on the right, e.g. \"See all\".",
          "type": [
            "string",
            "number"
          ]
        },
        "columns": {
          "description": "Number of columns (default 2).",
          "type": "number",
          "minimum": 1,
          "maximum": 8
        },
        "text": {
          "description": "The words.",
          "type": [
            "string",
            "number"
          ]
        },
        "lines": {
          "description": "Placeholder lines when there's no text.",
          "type": "number",
          "minimum": 1,
          "maximum": 30
        },
        "size": {
          "description": "Text size.",
          "enum": [
            "sm",
            "md",
            "lg"
          ]
        },
        "muted": {
          "description": "Grey instead of ink.",
          "type": "boolean"
        },
        "filled": {
          "description": "Dark fill.",
          "type": "boolean"
        },
        "variant": {
          "description": "primary = the main action (dark). Default secondary.",
          "enum": [
            "primary",
            "secondary",
            "outline",
            "text"
          ]
        },
        "icon": {
          "description": "Icon name (see wf vocab icons).",
          "enum": [
            "menu",
            "back",
            "close",
            "search",
            "plus",
            "minus",
            "check",
            "chevron-right",
            "chevron-down",
            "chevron-left",
            "heart",
            "star",
            "cart",
            "bag",
            "user",
            "users",
            "home",
            "bell",
            "settings",
            "share",
            "more",
            "map-pin",
            "clock",
            "calendar",
            "camera",
            "image",
            "mail",
            "phone",
