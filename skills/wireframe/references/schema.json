            "unlock",
            "eye-off",
            "fingerprint",
            "accessibility",
            "timer",
            "hourglass",
            "alarm",
            "history",
            "sparkle",
            "rocket",
            "idea",
            "target",
            "puzzle",
            "award",
            "trophy",
            "palette",
            "brush",
            "at-sign",
            "hash",
            "language"
          ]
        },
        "badge": {
          "description": "Small count dot, e.g. \"2\".",
          "type": [
            "string",
            "number"
          ]
        },
        "label": {
          "description": "Label above.",
          "type": [
            "string",
            "number"
          ]
        },
        "hint": {
          "description": "Placeholder.",
          "type": [
            "string",
            "number"
          ]
        },
        "value": {
          "description": "Typed value.",
          "type": [
            "string",
            "number"
          ]
        },
        "error": {
          "description": "Error text below.",
          "type": [
            "string",
            "number"
          ]
        },
        "rows": {
          "description": "Visible rows (default 3).",
          "type": "number",
          "minimum": 1,
          "maximum": 20
        },
        "checked": {
          "description": "Ticked.",
          "type": "boolean"
        },
        "items": {
          "description": "The options.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          ]
        },
        "on": {
          "description": "Switched on.",
          "type": "boolean"
        },
        "active": {
          "description": "The selected one.",
          "type": [
            "string",
            "number"
          ]
        },
        "back": {
          "description": "Show a back arrow (goes back).",
          "type": "boolean"
        },
        "actions": {
          "description": "Icons on the right: icon names, or { icon, goes }.",
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": [
                  "string",
                  "number"
                ]
              },
              {
                "$ref": "#/definitions/item"
              }
            ]
          }
        },
        "large": {
          "description": "Big title on its own line, left-aligned.",
          "type": "boolean"
        },
        "pages": {
          "description": "How many pages (default 5).",
          "type": "number",
          "minimum": 1,
          "maximum": 20
        },
        "current": {
          "description": "Current page (default 1).",
          "type": "number",
          "minimum": 1
        },
        "count": {
          "description": "How many (default 3).",
          "type": "number",
          "minimum": 1,
          "maximum": 12
        },
        "button": {
          "description": "A button on the far right, e.g. \"Order now\".",
          "type": [
            "string",
            "number"
          ]
        },
        "aspect": {
          "description": "Shape when there's no height: \"16:9\", \"1:1\", \"4:3\".",
          "type": [
            "string",
            "number"
          ]
        },
        "src": {
          "description": "Optional image file path, sketchified.",
          "type": [
            "string",
            "number"
          ]
        },
        "sketch": {
          "description": "false shows the picture as it is, instead of sketchified in grays.",
          "type": "boolean"
        },
        "crop": {
          "description": "Show only part of the picture: [left, top, right, bottom] as fractions (the editor's Crop button writes it).",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "round": {
          "description": "Round corners a lot (or a circle when square).",
          "type": "boolean"
        },
        "chevrons": {
          "description": "Show › on every row.",
          "type": "boolean"
        },
        "dividers": {
          "description": "Lines between rows (default true).",
          "type": "boolean"
        },
        "cards": {
          "description": "Each row as its own card.",
          "type": "boolean"
        },
        "kind": {
          "description": "Chart type (default bar).",
          "enum": [
            "bar",
            "line",
            "pie",
            "donut"
          ]
        },
        "type": {
          "description": "What it is (from the catalog).",
          "enum": [
            "stack",
            "row",
            "card",
            "section",
            "grid",
            "sheet",
            "dialog",
            "title",
            "heading",
            "text",
            "label",
            "link",
            "badge",
            "button",
            "icon-button",
            "input",
            "textarea",
            "search",
            "select",
            "checkbox",
            "radio",
            "toggle",
            "slider",
            "stepper",
            "segmented",
            "chips",
            "navbar",
            "tabbar",
            "tabs",
            "breadcrumbs",
            "pagination",
            "dots",
            "sidebar",
            "topnav",
            "image",
            "avatar",
            "icon",
            "list",
            "table",
            "chart",
            "map",
            "video",
            "rating",
            "divider",
            "spacer",
            "keyboard",
            "alert",
            "toast",
            "progress",
            "steps",
            "spinner",
            "sketch"
          ]
        },
        "use": {
          "description": "Use a piece from the file's `shared` section instead of a type, e.g. \"use\": \"tabs\". Other props override it.",
          "type": [
            "string",
            "number"
          ]
        },
        "id": {
          "description": "A name for this element, so links, nudges and agent pointers can find it.",
          "type": [
            "string",
            "number"
          ]
        },
        "goes": {
          "description": "Tapping it goes to this screen id (or \"back\").",
          "type": "string"
        },
        "pin": {
          "description": "Float it over the screen instead of stacking it (\"bottom\", \"top-right\", ...).",
          "enum": [
            "top",
            "bottom",
            "left",
            "right",
            "center",
            "top-left",
            "top-right",
            "bottom-left",
            "bottom-right"
          ]
        },
        "width": {
          "description": "\"fill\", \"hug\", or a number of px.",
          "oneOf": [
            {
              "enum": [
                "fill",
                "hug"
              ]
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "height": {
          "description": "Height in px (most things size themselves).",
          "type": "number",
          "minimum": 4
        },
        "grow": {
          "description": "Take a share of leftover space along the stack (a spacer grows by default).",
          "type": "number",
          "minimum": 0
        },
        "note": {
          "description": "A designer's note. Shown as a numbered sticky beside the screen on the canvas, never on the screen itself.",
          "type": [
            "string",
            "number"
          ]
        },
        "at": {
          "description": "Place it freely at [x, y] on the screen, outside the stacks (top-level elements only). The editor writes this when a designer drags something in; agents should prefer stacks.",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
