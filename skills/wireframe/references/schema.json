            "arrow-up",
            "arrow-down",
            "arrow-left",
            "arrow-right",
            "chevron-up",
            "external",
            "expand",
            "collapse",
            "undo",
            "redo",
            "sort",
            "drag",
            "sidebar",
            "zoom-in",
            "zoom-out",
            "copy",
            "save",
            "print",
            "attach",
            "pin",
            "flag",
            "tag",
            "archive",
            "inbox",
